# Copy this file to .env and fill it in, then run ./scripts/deploy.sh
# .env is ignored by git. Never commit it.

# ---------------------------------------------------------------------------
# Cloudflare (required)
# ---------------------------------------------------------------------------
# Account id: Cloudflare dashboard, right hand column of any account page.
CLOUDFLARE_ACCOUNT_ID=

# API token: dashboard, My Profile, API Tokens, Create Token, Custom token.
# Give it these permissions on your account:
#   Workers Scripts        Edit    deploying the Worker and setting its secrets
#   D1                     Edit    creating the database and applying migrations
#   Vectorize              Edit    creating the index and its metadata index
#   Workers AI             Edit    the model binding the Worker runs on
#   Cloudflare Pages       Edit    deploying the interface
#   Workers R2 Storage     Edit    only if you set R2_BUCKET_NAME below
#   Account Settings       Read    used to confirm the token works
# Leave it out to authenticate interactively with `npx wrangler login` instead.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Where it will live (required)
# ---------------------------------------------------------------------------
# The Worker serves the API, Pages serves the interface. The deploy script
# prints the URLs it created if you leave these blank on a first run.
API_ORIGIN=https://rag-in-the-box.YOUR-SUBDOMAIN.workers.dev
WEB_ORIGIN=https://rag-in-the-box.pages.dev

# ---------------------------------------------------------------------------
# Secrets (required)
# ---------------------------------------------------------------------------
# Generate each with:  node -e "console.log(crypto.randomUUID().replaceAll('-',''))"
# BETTER_AUTH_SECRET signs session cookies. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# ADMIN_TOKEN protects tenant provisioning and the demo seeding script.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Resource names (optional, sensible defaults)
# ---------------------------------------------------------------------------
WORKER_NAME=rag-in-the-box
PAGES_PROJECT=rag-in-the-box
D1_DATABASE_NAME=rag-db
VECTORIZE_INDEX_NAME=rag-index

# ---------------------------------------------------------------------------
# R2 object storage (optional)
# ---------------------------------------------------------------------------
# Name a bucket here and the deploy script creates it and binds it as BUCKET.
# Leave it blank and the Worker runs without object storage, which is the
# default and costs nothing.
#
# What it buys you: the original file is kept when a scanned document is sent
# to LlamaParse, so a failed parse can be retried without asking for the upload
# again. Nothing else reads it. The settings screen shows whether it is on.
#
# R2 free tier, from https://developers.cloudflare.com/r2/pricing/ :
#   10 GB-month storage, 1,000,000 class A operations, 10,000,000 class B,
#   and no egress charge. Standard storage only.
#
# Setting this needs Workers R2 Storage: Edit on the API token above.
R2_BUCKET_NAME=

# ---------------------------------------------------------------------------
# R2 S3 API credentials (optional)
# ---------------------------------------------------------------------------
# Only needed to reach the bucket from OUTSIDE a Worker: backups, migration,
# bulk download, rclone, the aws CLI. The Worker itself never uses these,
# because a binding needs no credentials at all.
#
# Create them in the dashboard: R2, Manage next to API Tokens, then choose a
# permission level. Object Read only is enough for backups; Object Read & Write
# is needed to restore. You are shown the secret once.
#
# The endpoint is your account id followed by r2.cloudflarestorage.com. Use the
# jurisdiction host instead if the bucket was created in one:
#   default   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   EU        https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
#   US        https://<ACCOUNT_ID>.us.r2.cloudflarestorage.com
#
# Source: https://developers.cloudflare.com/r2/api/tokens/
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# Dimension of the vector index. It is fixed once the index is created, and
# changing it means creating a new index and re-embedding everything.
#   384   @cf/baai/bge-small-en-v1.5, the free default
#   768   @cf/baai/bge-base-en-v1.5
#   1024  @cf/baai/bge-m3
# OpenAI's text-embedding-3 models can fill any of these.
VECTOR_DIMENSIONS=384

# ---------------------------------------------------------------------------
# Optional providers
# ---------------------------------------------------------------------------
# Leave every one of these blank to run entirely on Cloudflare's free plan.
# Each one that is set appears as a choice on the settings screen.

# Better answers, billed by OpenAI. Also usable for embeddings.
OPENAI_API_KEY=
# Billed by DeepSeek. The same models are on Workers AI without an account.
DEEPSEEK_API_KEY=
# Reads scanned documents. The free plan gives 10,000 credits a month, which
# is about 3,300 pages at the cost effective tier.
LLAMA_CLOUD_API_KEY=

# Endpoint overrides. Leave blank to use each vendor's own default.
#
# LlamaCloud runs a separate EU region and its API keys are region specific, so
# a key created in the EU fails against the North American host. Set this to
# https://api.cloud.eu.llamaindex.ai if your key is a European one.
LLAMA_CLOUD_BASE_URL=
# For an OpenAI compatible proxy or gateway in front of either provider.
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=

# Base URL of an Ollama server, with no trailing slash and no /v1 suffix.
# Mostly a local development setting: see docs/local-models.md. Set it on a
# deployment only if the Worker can actually reach that address, which it
# cannot for a server on your own machine.
OLLAMA_BASE_URL=

# ---------------------------------------------------------------------------
# Tier
# ---------------------------------------------------------------------------
# The tier every new workspace starts on. It can be changed per workspace from
# the settings screen at any time.
#   free  limits sized for the Cloudflare free plan
#   paid  higher limits, server side parsing, scanned document support
DEFAULT_TIER=free

# PBKDF2 iterations for password hashing. 100000 costs about 5 ms of processor
# time, which fits the free plan's 10 ms budget. On the Workers Paid plan set
# this to 600000, which is the current OWASP guidance. Raising it never locks
# out an existing account: each hash records the count it was made with.
PASSWORD_KDF_ITERATIONS=100000

# ---------------------------------------------------------------------------
# Branding (optional)
# ---------------------------------------------------------------------------
# The interface is a static build, so these are read when it is built, not at
# runtime. Every one falls back to this project's own value.
#
# This matters for a fork: without setting them your landing page links to the
# original author's site and repository. Attribution is fine under the licence,
# but the pages should say who is actually running them.
#
# The paid setup panel stays hidden until VITE_SETUP_EMAIL is set, so nobody
# accidentally advertises a service they do not offer, and no address is
# compiled into a build that does not want one.
VITE_BRAND_NAME=
VITE_REPO_URL=
VITE_DEMO_URL=
VITE_AUTHOR_NAME=
VITE_AUTHOR_URL=
VITE_SETUP_OFFER=
VITE_SETUP_PRICE=
VITE_SETUP_EMAIL=

# Opening questions offered on the demo, separated by a pipe. These are about
# whichever document you seeded, so change them when you change the document.
# Blank uses the defaults, which suit the NIST framework seeded by default.
VITE_DEMO_SUGGESTIONS=
