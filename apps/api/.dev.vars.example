# Optional. Local development works without this file: apps/api/wrangler.toml
# carries development values for everything the Worker needs.
#
# Copy to .dev.vars to override any of them. .dev.vars is ignored by git.

# Try the public demo behaviour locally, including the daily allowance banner.
# APP_MODE=demo
# DEMO_TENANT_ID=demo-curated
# DEMO_COOKIE_SECRET=anything-local
# DEMO_VISITOR_CHATS_PER_DAY=4
# DEMO_GLOBAL_CHATS_PER_DAY=6

# Point at a real model instead of the offline stand-ins. Requires Cloudflare
# credentials for Workers AI, so `npx wrangler login` first.
# OFFLINE_AI=false

# Run real models on your own machine instead, with no account anywhere.
#
#   docker compose up -d && npm run ollama:pull
#
# Then uncomment the line below, restart the API, and choose the local models
# in Settings. Ollama outranks OFFLINE_AI, so the stand-ins step aside as soon
# as a local provider is picked. See docs/local-models.md.
# OLLAMA_BASE_URL=http://localhost:11434

# Try a provider you have a key for.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# LLAMA_CLOUD_API_KEY=
