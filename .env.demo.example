# Configuration for the public demo deployment.
#
# Copy to .env.demo and fill in, then run:  ./scripts/deploy.sh --profile demo
# .env.demo is ignored by git. Never commit it.
#
# The demo is a separate Worker, a separate database and a separate vector
# index from any self hosted install. Nothing here is shared with a normal
# deployment, so a mistake in the demo cannot reach anyone else's data.

# ---------------------------------------------------------------------------
# Cloudflare (required)
# ---------------------------------------------------------------------------
# Account id: dashboard, right hand column of any account page.
CLOUDFLARE_ACCOUNT_ID=

# API token needs the same permissions as a self hosted install, listed in
# .env.example and in docs/hosting.md:
#   Workers Scripts, D1, Vectorize, Workers AI, Cloudflare Pages   all Edit
#   Account Settings                                               Read
#   Workers R2 Storage                                             Edit, only
#     if R2_BUCKET_NAME below is set
#
# Use a token scoped to this account and nothing else. It can deploy Workers,
# so treat it like a password.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Where the demo lives
# ---------------------------------------------------------------------------
API_ORIGIN=https://rib-api.example.com
WEB_ORIGIN=https://rib.example.com
CLOUDFLARE_WORKER_URL=
# Additional origins allowed to call the API, comma separated.
#
# A Pages project keeps its pages.dev address whatever custom domain you add,
# and a custom domain on a zone held by a different Cloudflare account cannot be
# attached from the account running the Worker. In both cases the site is
# reachable at more than one address and every one of them has to be allowed,
# or the browser is refused by CORS at whichever address someone opens.
ALLOWED_ORIGIN_EXTRA=

# ---------------------------------------------------------------------------
# Secrets (required)
# ---------------------------------------------------------------------------
# Use values that are not used anywhere else. The demo has no accounts, so
# BETTER_AUTH_SECRET is only used to derive the per visitor quota key.
BETTER_AUTH_SECRET=
ADMIN_TOKEN=
# Salts the hash used to meter one visitor. Raw addresses are never stored.
DEMO_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Resource names
# ---------------------------------------------------------------------------
WORKER_NAME=rag-in-the-box-demo
PAGES_PROJECT=rag-in-the-box-demo
D1_DATABASE_NAME=rag-demo-db
VECTORIZE_INDEX_NAME=rag-demo-index
VECTOR_DIMENSIONS=384

# R2 object storage. Blank leaves it off, which is right for the demo: the
# only thing it stores is the original of a scanned document sent to
# LlamaParse, and the demo does not do server side parsing. Naming a bucket
# here would keep visitors' files in a second place the purge does not reach.
R2_BUCKET_NAME=
# ---------------------------------------------------------------------------
# R2 S3 API credentials (optional)
# ---------------------------------------------------------------------------
# Only needed to reach the bucket from OUTSIDE a Worker: backups, migration,
# bulk download, rclone, the aws CLI. The Worker itself never uses these,
# because a binding needs no credentials at all.
#
# Create them in the dashboard: R2, Manage next to API Tokens, then choose a
# permission level. Object Read only is enough for backups; Object Read & Write
# is needed to restore. You are shown the secret once.
#
# The endpoint is your account id followed by r2.cloudflarestorage.com. Use the
# jurisdiction host instead if the bucket was created in one:
#   default   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   EU        https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
#   US        https://<ACCOUNT_ID>.us.r2.cloudflarestorage.com
#
# Source: https://developers.cloudflare.com/r2/api/tokens/
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Daily allowances
# ---------------------------------------------------------------------------
# These exist so the demo cannot cost anything to run. Cloudflare grants 10,000
# Workers AI neurons a day. One answer from @cf/openai/gpt-oss-20b with six
# retrieved passages costs roughly 65 neurons, so about 150 answers a day fit
# inside the free grant. The global cap below leaves headroom on purpose.
#
# The per visitor cap is keyed on a salted hash of the network address, not on
# a cookie, so clearing cookies does not hand out a fresh allowance.
DEMO_TENANT_ID=demo-curated
DEMO_VISITOR_CHATS_PER_DAY=12
DEMO_GLOBAL_CHATS_PER_DAY=110

# ---------------------------------------------------------------------------
# Visitor uploads
# ---------------------------------------------------------------------------
# The curated document shows the product answers questions. Only a visitor's
# own file shows it answers questions about what they care about, which is the
# question they actually have. One small file each settles it.
#
# The cost is vector storage, which does not reset daily. A free Vectorize index
# holds about 13,000 passages at 384 dimensions, so uploads left in place would
# fill it permanently within weeks. The scheduled purge is what makes this
# affordable, so do not raise the retention without doing that arithmetic again.
DEMO_UPLOADS_ENABLED=true
DEMO_VISITOR_UPLOADS_PER_DAY=1
DEMO_GLOBAL_UPLOADS_PER_DAY=30

# Two megabytes is a few pages, which is enough to watch the pipeline run and
# small enough that a stranger cannot cost much.
DEMO_MAX_UPLOAD_BYTES=2097152

# How long an upload survives. The cron trigger in apps/api/wrangler.toml runs
# the purge hourly. Visitors are told this figure before they upload, and they
# can export everything first.
DEMO_RETENTION_HOURS=3

# ---------------------------------------------------------------------------
# Which platform reads a visitor's file
# ---------------------------------------------------------------------------
# The demo offers a toggle between two free platforms, and this turns the
# second one on. Cloudflare is always there: the browser extracts the text and
# Workers AI embeds it, which costs nothing and needs nothing configured.
#
# LlamaIndex is the supplement. The file goes to LlamaParse, which returns
# markdown that the same Workers AI model then embeds, so the only thing the
# toggle changes is who reads the file. It is worth offering because the
# Cloudflare path cannot read a scanned page at all: there is no text in the
# file to extract. LlamaParse does optical character recognition and can.
#
# Needs LLAMA_CLOUD_API_KEY below. Without it the toggle never appears, so the
# interface cannot offer a choice this deployment could not honour.
DEMO_LLAMAPARSE_ENABLED=false

# Parsing gets its own daily budget because it spends a different scarce thing
# from an upload: LlamaCloud credits rather than Vectorize storage.
#
# The free LlamaCloud plan grants 10,000 credits a month. At three credits a
# page on the cost_effective tier that is about 3,300 pages a month, or 110 a
# day. Twenty parses a day of five pages each spends 300 credits a day and
# 9,000 a month, which fits with headroom for a heavier day. Raise these
# without redoing that arithmetic and the demo fails halfway through a month.
DEMO_VISITOR_PARSES_PER_DAY=1
DEMO_GLOBAL_PARSES_PER_DAY=20

# ---------------------------------------------------------------------------
# The document the demo answers from
# ---------------------------------------------------------------------------
# Fetched at seeding time rather than committed, so no third party bytes live
# in this repository. The default is a work of the United States government and
# is in the public domain.
DEMO_DOCUMENT_URL=https://nvlpubs.nist.gov/nistpubs/CSWP/NIST.CSWP.29.pdf
DEMO_DOCUMENT_TITLE=NIST Cybersecurity Framework 2.0.pdf

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# The demo answers on Workers AI, which is what keeps it free, so the two
# hosted chat providers stay blank here. They are listed because a self hosted
# install can use them and because this file is meant to show every provider
# the project supports, not only the ones the demo happens to run.
#
#   OPENAI_API_KEY    chat and an alternative embedding model, billed by OpenAI
#   DEEPSEEK_API_KEY  chat, billed by DeepSeek
#
# Both are OpenAI compatible, so both are reached through the same code path.
# docs/providers.md says what each one costs and when it is worth adding.
#
# LLAMA_CLOUD_API_KEY is different: it is the one the demo does use. It is what
# DEMO_LLAMAPARSE_ENABLED above switches on, and it is free within the grant
# that section sizes the daily cap against.
#
# Check any of them with:  ./scripts/check-credentials.sh --file .env.demo
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLAMA_CLOUD_API_KEY=

# Base URL of an Ollama server. Leave blank on the demo: a deployed Worker
# cannot reach a server on your own machine, and the demo has no settings
# screen for a visitor to select the local models anyway. It is here so this
# file lists every provider the self hosted template does.
OLLAMA_BASE_URL=
# Endpoint overrides. Leave blank to use each vendor's own default.
#
# LlamaCloud runs a separate EU region and its API keys are region specific, so
# a key created in the EU fails against the North American host. Set this to
# https://api.cloud.eu.llamaindex.ai if your key is a European one.
LLAMA_CLOUD_BASE_URL=
# For an OpenAI compatible proxy or gateway in front of either provider. Blank
# uses the vendor's own endpoint, which is what almost everyone wants:
# https://api.openai.com/v1 and https://api.deepseek.com/v1 respectively.
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=

DEFAULT_TIER=free
PASSWORD_KDF_ITERATIONS=100000

# ---------------------------------------------------------------------------
# Branding (optional)
# ---------------------------------------------------------------------------
# The interface is a static build, so these are read when it is built, not at
# runtime. Every one falls back to this project's own value.
#
# The demo is the shop window, so set these. The paid setup panel stays hidden
# until VITE_SETUP_EMAIL is set, which is what makes the offer appear at all.
VITE_BRAND_NAME=
VITE_REPO_URL=
VITE_DEMO_URL=
VITE_AUTHOR_NAME=
VITE_AUTHOR_URL=
VITE_SETUP_OFFER=
VITE_SETUP_PRICE=
VITE_SETUP_EMAIL=

# Opening questions offered on the demo, separated by a pipe. These are about
# whichever document you seeded, so change them when you change the document.
# Blank uses the defaults, which suit the NIST framework seeded by default.
VITE_DEMO_SUGGESTIONS=
